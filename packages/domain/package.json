{
  "name": "@coxia/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Regras de negócio da Coxia (agenda, contas, lembretes, briefing, comandos, projetos). Usado pela api e pelo worker.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "require": "./dist/index.js", "default": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts --clean",
    "dev": "tsup src/index.ts --format cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@coxia/contracts": "workspace:*",
    "@coxia/database": "workspace:*",
    "@coxia/shared": "workspace:*",
    "luxon": "^3.6.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.6.2",
    "@types/node": "^20.17.0",
    "tsup": "^8.5.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
