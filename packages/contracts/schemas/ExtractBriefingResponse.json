{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "briefing": {
      "type": "object",
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "objective": {
          "type": [
            "string",
            "null"
          ]
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deadlines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string"
              },
              "date": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "description",
              "date"
            ],
            "additionalProperties": false
          }
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "responsibility": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "name",
              "responsibility"
            ],
            "additionalProperties": false
          }
        },
        "estimatedBudgetCents": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "openQuestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proposedTasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "assigneeName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "dueDate": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "title",
              "assigneeName",
              "dueDate"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "objective",
        "deliverables",
        "deadlines",
        "owners",
        "estimatedBudgetCents",
        "openQuestions",
        "proposedTasks"
      ],
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "executionId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string"
        },
        "promptVersion": {
          "type": "string"
        },
        "parserVersion": {
          "type": "string"
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "latencyMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "executionId",
        "model",
        "promptVersion",
        "parserVersion",
        "inputTokens",
        "outputTokens",
        "latencyMs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "briefing",
    "meta"
  ],
  "additionalProperties": false
}
