{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "text": {
      "type": "string"
    },
    "durationSeconds": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "meta": {
      "type": "object",
      "properties": {
        "executionId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string"
        },
        "promptVersion": {
          "type": "string"
        },
        "parserVersion": {
          "type": "string"
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "latencyMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "executionId",
        "model",
        "promptVersion",
        "parserVersion",
        "inputTokens",
        "outputTokens",
        "latencyMs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "text",
    "durationSeconds",
    "meta"
  ],
  "additionalProperties": false
}
