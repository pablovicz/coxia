# Copie para .env. O docker-compose lê este arquivo automaticamente; os apps no host
# (pnpm dev) também leem estas variáveis se você exportá-las (ex.: `set -a; . ./.env; set +a`).
# Nunca versione o .env. Em produção, as variáveis vêm do Railway (.railway/railway.ts).

# ---------- Docker Compose ----------
# Porta do Postgres no host (use 5433 se já houver um Postgres local na 5432).
POSTGRES_PORT=5432

# ---------- Comuns (api e worker) ----------
NODE_ENV=development
LOG_LEVEL=debug
DATABASE_URL=postgresql://coxia:coxia@localhost:5432/coxia?schema=public
REDIS_URL=redis://localhost:6379
ORG_DEFAULT_TIMEZONE=America/Sao_Paulo

# ---------- WhatsApp ----------
# "fake" (padrão local, registra envios em memória) ou "zapi".
WHATSAPP_PROVIDER=fake
ZAPI_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
# Token de segurança da conta Z-API (header Client-Token).
ZAPI_CLIENT_TOKEN=
# Segredo longo no caminho do callback: https://<api>/webhooks/zapi/<ZAPI_WEBHOOK_SECRET>
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ZAPI_WEBHOOK_SECRET=dev-webhook-secret-change-me

# ---------- Serviço de IA ----------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=dev-ai-service-token
AI_TIMEOUT_MS=60000
# "fixture" = respostas determinísticas de tests/fixtures/ai; "openai" = chamadas reais.
AI_PROVIDER=fixture
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# ---------- Storage S3 (MinIO local) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=coxia-media
S3_ACCESS_KEY_ID=coxia
S3_SECRET_ACCESS_KEY=coxia-dev-secret
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL=900

# ---------- api ----------
PORT=3000
JWT_SECRET=dev-jwt-secret-dev-jwt-secret-0000
JWT_EXPIRES_IN=12h
CORS_ORIGINS=http://localhost:5173

# ---------- worker ----------
WORKER_CONCURRENCY=5
WORKER_HEALTH_PORT=3001
MORNING_BRIEFING_TIME=08:00

# ---------- web ----------
VITE_API_URL=http://localhost:3000

# ---------- seed (pnpm db:seed) ----------
SEED_ADMIN_EMAIL=admin@casakaju.local
SEED_ADMIN_PASSWORD=troque-esta-senha
SEED_ADMIN_NAME=Administradora
SEED_ADMIN_PHONE=
